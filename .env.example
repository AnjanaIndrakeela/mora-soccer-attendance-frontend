# Backend the /api/* rewrite proxies to. Read at BUILD time (next.config.ts rewrites),
# so set it before `npm run build` / in Vercel's project env vars.
BACKEND_URL=http://localhost:8000

# Timezone used to display times and to interpret times entered in forms.
NEXT_PUBLIC_TEAM_TIMEZONE=Asia/Colombo

# Dev only: this computer's Wi-Fi IP (comma-separated hostnames, no port), so phones on the
# same network can open the dev server to test QR check-in. Find it with `ipconfig`.
ALLOWED_DEV_ORIGINS=
